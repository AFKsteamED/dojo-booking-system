# 複製這支檔為 .env.local，逐步填入。留空的項目會走「開發模式」（假身分/停用）。

# ── LINE LIFF（M1 用）──────────────────────────────
# 來自「LINE Login channel」> LIFF 分頁（不是 Messaging API channel）。
# 沒填時，前端會用固定的假身分，方便本機開發。
NEXT_PUBLIC_LIFF_ID=

# LINE Login channel 的「Channel ID」（純數字），用來驗證 ID Token 的真實性。
# 在 LINE Developers > 你的 LINE Login channel > Basic settings 找到。
LINE_LOGIN_CHANNEL_ID=

# ── LINE Messaging API（M5 通知用）───────────────
# 來自「Messaging API channel」；與上面 LIFF 的 Login channel 放同一個 Provider。
# Channel access token 從該 channel 的 Messaging API 分頁取得。留空則不發推播。
LINE_CHANNEL_ACCESS_TOKEN=
# 保護開課提醒 cron 的密鑰（隨機字串）
CRON_SECRET=

# ── Supabase（M2 起用）────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key 只在伺服器端使用，切勿加 NEXT_PUBLIC_ 前綴、切勿外流
SUPABASE_SERVICE_ROLE_KEY=

# ── 教練後台登入（M4）────────────────────────────
ADMIN_PASSWORD=
# 隨機字串，可用 `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"` 產生
ADMIN_SESSION_SECRET=
