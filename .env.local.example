# 複製為 .env.local 後填入。正式環境的值設定在 Vercel 的 Environment Variables。
# 本機開發時，LINE 相關欄位可留空：在 localhost 會自動使用開發用的假身分，推播則會略過。

# ── LINE Login（會員登入）────────────────────────────
# LINE Login channel → LIFF 分頁的 LIFF ID
NEXT_PUBLIC_LIFF_ID=
# LINE Login channel → Basic settings 的 Channel ID（純數字），用來驗證 ID Token
LINE_LOGIN_CHANNEL_ID=

# ── LINE Messaging API（推播通知）────────────────────
# Messaging API channel 的 Channel access token；留空則不發推播
LINE_CHANNEL_ACCESS_TOKEN=

# ── Supabase ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 只在伺服器端使用，切勿加 NEXT_PUBLIC_ 前綴
SUPABASE_SERVICE_ROLE_KEY=

# ── 教練後台 ─────────────────────────────────────────
ADMIN_PASSWORD=
# 隨機字串，例如：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SESSION_SECRET=
# 後台被連續輸錯鎖定時，LINE 通知的對象：管理者的 LINE User ID（U 開頭，需已加官方帳號好友）
ADMIN_ALERT_LINE_USER_ID=

# ── 排程端點 ─────────────────────────────────────────
# Vercel Cron 與 Supabase pg_cron（db/08）呼叫 /api/cron/* 時使用的密鑰，兩邊需設定相同的值
CRON_SECRET=

# ── 僅限本機 ─────────────────────────────────────────
# '1' 強制使用假身分、'0' 強制使用真 LIFF；不設則自動判斷。正式環境請勿設定
# NEXT_PUBLIC_LIFF_MOCK=
